# এই ফাইলটা কপি করে .env নামে রাখুন, তারপর আসল মান বসান।
# নতুন SECRET_KEY বানাতে:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

SECRET_KEY='change-me'
DEBUG=False
ALLOWED_HOSTS=example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com

# Database: sqlite3 অথবা postgresql
DB_ENGINE=sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=''
DB_HOST=localhost
DB_PORT=5432

# bKash
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta/
BKASH_APP_KEY=''
BKASH_APP_SECRET=''
BKASH_USERNAME=''
BKASH_PASSWORD=''
BKASH_USE_BEARER=True

# Email
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=''
SUPPORT_EMAIL=
